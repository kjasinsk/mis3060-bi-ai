// HW6 Part B: every measure/slice the reconciliation needs, one row each.
// Run in DAX query view, copy the grid, save as reports/powerbi_values.csv
EVALUATE
UNION (
    ROW ( "measure", "AUM (naive SUM)", "slice", "All", "value", CONVERT ( [AUM (naive SUM)], STRING ) ),
    ROW ( "measure", "Ending AUM", "slice", "All", "value", CONVERT ( [Ending AUM], STRING ) ),
    ROW ( "measure", "Ending Clients", "slice", "All", "value", CONVERT ( [Ending Clients], STRING ) ),
    ROW ( "measure", "Avg AUM per Client", "slice", "All", "value", CONVERT ( [Avg AUM per Client], STRING ) ),
